[Unit]
Description=gunicorn daemon
After=network.target

[Service]
User=user
Group=www-data
WorkingDirectory=/home/user/randomAttendance
Environment="PATH=/home/user/Env/randomAttendance/bin"
ExecStart=/home/user/Env/randomAttendance/bin/gunicorn --access-logfile - --workers 3 --bind unix:/home/user/randomAttendance/attendance.sock attendance.wsgi:application


[Install]
WantedBy=multi-user.target
